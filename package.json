{
  "name": "school-management-saas",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:local": "bash scripts/dev.sh local",
    "dev:cloud": "bash scripts/dev.sh cloud",
    "dev:demo": "bash scripts/dev.sh demo",
    "demo:reset": "bash scripts/demo-db.sh --reset && bash scripts/dev.sh demo",
    "test:browser": "bash scripts/with-test-db.sh npx playwright test",
    "dev:worker": "npm run worker -w backend",
    "build": "npm run build --workspaces",
    "test": "bash scripts/with-test-db.sh npm run test -w backend",
    "db:start": "bash scripts/local-db.sh",
    "db:migrate": "npm run migrate -w backend",
    "db:migrate:supabase": "npm run migrate:supabase -w backend --",
    "db:check:supabase": "npm run check:supabase -w backend",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "agent-browser": "0.27.0"
  }
}
