{
  "name": "@school/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "worker": "npm run build && node --env-file-if-exists=../.env dist/jobs/worker.js",
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node --env-file-if-exists=../.env --watch dist/main.js",
    "check:supabase": "node --env-file-if-exists=../.env --import tsx scripts/check-supabase.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:supabase": "node --env-file-if-exists=../.env --import tsx scripts/migrate-supabase.ts",
    "seed": "tsx scripts/seed.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "platform-admin": "tsx scripts/create-platform-admin.ts",
    "ai:eval": "tsx scripts/ai-eval.ts",
    "test": "npm run build && NODE_ENV=test DATABASE_TARGET=local tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
